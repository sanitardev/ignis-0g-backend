# Local development only. Compose reads .env; host Python uses exported variables.
POSTGRES_PASSWORD=ignis_local
DATABASE_URL=postgresql+asyncpg://ignis:ignis_local@127.0.0.1:55432/ignis
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LLM_BASE_URL=https://ts.ree.kz/api/ai/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5-5
# Leave BASE_URL blank to use the same gateway and key.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_SEND_DIMENSIONS=true
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=
