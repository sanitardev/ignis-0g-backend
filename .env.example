# Local development only. Compose reads .env; host Python uses exported variables.
POSTGRES_PASSWORD=ignis_local
DATABASE_URL=postgresql+asyncpg://ignis:ignis_local@127.0.0.1:55432/ignis
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LLM_BASE_URL=https://llm.alem.ai/v1
LLM_API_KEY=
LLM_MODEL=qwen3-8
# Each Alem endpoint has its own key.
EMBEDDING_BASE_URL=https://llm.alem.ai/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-1024
EMBEDDING_SEND_DIMENSIONS=false
RERANKER_BASE_URL=https://llm.alem.ai/v1
RERANKER_API_KEY=
RERANKER_MODEL=reranker
RAG_MAX_OUTPUT_TOKENS=3200
